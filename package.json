{
  "name": "carol-design-system",
  "private": true,
  "description": "team carol 공용 디자인 시스템",
  "license": "MIT",
  "workspaces": [
    "packages/design-system",
    "apps/docs"
  ],
  "scripts": {
    "build": "npm run build -w @team-carol/design-system",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "docs": "npm run build && npm run dev -w carol-docs",
    "docs:build": "npm run build && npm run build -w carol-docs"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
